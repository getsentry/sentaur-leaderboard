@page "/"
@inject HttpClient Http

<PageTitle>Leaderboard</PageTitle>

<h1><span>Sentaur Survivors • Scores</span></h1>

@if (scores == null)
{
    <p>
    <em>Loading...</em>
</p>
}
else
{
    <table class="table">
    <thead>
        <tr>
            <th @onclick="() => SortBy(nameof(ScoreEntry.Name))" style="cursor: pointer;">
                Name @GetSortIndicator(nameof(ScoreEntry.Name))
            </th>
            <th @onclick="() => SortBy(nameof(ScoreEntry.Score))" style="cursor: pointer;">
                Score @GetSortIndicator(nameof(ScoreEntry.Score))
            </th>
            <th @onclick="() => SortBy(nameof(ScoreEntry.Duration))" style="cursor: pointer;">
                Time @GetSortIndicator(nameof(ScoreEntry.Duration))
            </th>
            <th @onclick="() => SortBy(nameof(ScoreEntry.Timestamp))" style="cursor: pointer;">
                Recorded @GetSortIndicator(nameof(ScoreEntry.Timestamp))
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var score in GetSortedScores())
            {
                <tr>
                    <td>@score.Name</td>
                    <td>@score.Score</td>
                    <td>@score.Duration.ToString(@"mm\:ss")</td>
                    <td>@score.Timestamp.ToLocalTime().ToString("dddd, h:mm tt")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private ScoreEntry[]? scores;
    private string? _sortColumn;
    private bool _sortAscending = true;

    protected override async Task OnInitializedAsync()
    {
        // TODO: URL needs to come from config
        const string api =
            "https://sentaur-leaderboard-f7z2cjcdzq-uc.a.run.app/score";
            // "http://localhost:5203/score";
        scores = await Http.GetFromJsonAsync<ScoreEntry[]>(api);
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string GetSortIndicator(string column)
    {
        if (_sortColumn != column)
            return string.Empty;

        return _sortAscending ? "▲" : "▼";
    }

    private IEnumerable<ScoreEntry> GetSortedScores()
    {
        if (scores == null)
            return Array.Empty<ScoreEntry>();

        IEnumerable<ScoreEntry> sorted = _sortColumn switch
        {
            nameof(ScoreEntry.Name) => _sortAscending
                ? scores.OrderBy(s => s.Name)
                : scores.OrderByDescending(s => s.Name),
            nameof(ScoreEntry.Score) => _sortAscending
                ? scores.OrderBy(s => s.Score)
                : scores.OrderByDescending(s => s.Score),
            nameof(ScoreEntry.Duration) => _sortAscending
                ? scores.OrderBy(s => s.Duration)
                : scores.OrderByDescending(s => s.Duration),
            nameof(ScoreEntry.Timestamp) => _sortAscending
                ? scores.OrderBy(s => s.Timestamp)
                : scores.OrderByDescending(s => s.Timestamp),
            _ => scores
        };

        return sorted;
    }

    ISpan? _pageLoad;
    protected override void OnInitialized()
    {
        SentrySdk.ConfigureScope(s => _pageLoad = s.Transaction = SentrySdk.StartTransaction("leaderboard", "pageload"));
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        _pageLoad?.Finish();
        _pageLoad = null;
    }

}
